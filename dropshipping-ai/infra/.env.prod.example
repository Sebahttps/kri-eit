# Copiar a .env.prod y completar. NO commitear .env.prod.
#   cp .env.prod.example .env.prod

# --- Secretos (obligatorios, el compose falla si faltan) ---

# Contraseña de PostgreSQL. Generar con: openssl rand -hex 24
POSTGRES_PASSWORD=

# Clave de la API de Anthropic (agentes IA): https://console.anthropic.com
ANTHROPIC_API_KEY=

# Firma de los JWT de supervisores. Generar con: openssl rand -hex 32
BUSINESS_JWT_SECRET=

# --- Dominios (sin https://, deben apuntar por DNS a este servidor) ---

# La vitrina pública vive en la raíz del dominio (Shopify, modo híbrido).
# Este es el canal propio, por eso "hola" y no "tienda".
STORE_DOMAIN=hola.tudominio.cl
DASHBOARD_DOMAIN=panel.tudominio.cl
API_DOMAIN=api.tudominio.cl

# Email para los certificados Let's Encrypt (avisos de expiración)
ACME_EMAIL=

# --- Modo híbrido con Shopify (opcional, ver docs/shopify-hybrid.md) ---
# Dejar vacíos si no se usa Shopify: el conector queda desactivado.

# Dominio myshopify de la tienda, ej. mitienda.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Credenciales de la app del Dev Dashboard (Settings → Client ID / Client secret).
# Desde enero de 2026 las apps nuevas NO entregan un token shpat_ permanente:
# el gateway intercambia estas credenciales por un token de 24 h y lo renueva
# solo. Requiere que la app y la tienda estén en la misma organización.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Secreto de firma de los webhooks. Para webhooks creados por API (lo que hace
# scripts/configure-shopify.ps1) es el MISMO Client Secret de arriba.
SHOPIFY_WEBHOOK_SECRET=

# Versión de la Admin API. Shopify soporta cada versión ~12 meses; subirla
# aquí evita tener que tocar el código. Vacío = 2026-04.
SHOPIFY_API_VERSION=

# Solo para apps personalizadas creadas en el admin ANTES del 1-ene-2026, que
# sí tienen shpat_ permanente. Si se define, tiene prioridad sobre CLIENT_ID/
# CLIENT_SECRET. Para una app nueva, dejar VACÍO.
SHOPIFY_ADMIN_TOKEN=
