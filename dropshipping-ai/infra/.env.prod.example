# Copiar a .env.prod y completar. NO commitear .env.prod.
#   cp .env.prod.example .env.prod

# --- Secretos (obligatorios, el compose falla si faltan) ---

# Contraseña de PostgreSQL. Generar con: openssl rand -hex 24
POSTGRES_PASSWORD=

# Clave de la API de Anthropic (agentes IA): https://console.anthropic.com
ANTHROPIC_API_KEY=

# Firma de los JWT de supervisores. Generar con: openssl rand -hex 32
BUSINESS_JWT_SECRET=

# --- Dominios (sin https://, deben apuntar por DNS a este servidor) ---

STORE_DOMAIN=tienda.tudominio.cl
DASHBOARD_DOMAIN=panel.tudominio.cl
API_DOMAIN=api.tudominio.cl

# Email para los certificados Let's Encrypt (avisos de expiración)
ACME_EMAIL=

# --- Modo híbrido con Shopify (opcional, ver docs/shopify-hybrid.md) ---
# Dejar vacíos si no se usa Shopify: el conector queda desactivado.

# Secreto de firma de los webhooks (Shopify lo muestra al crear el webhook)
SHOPIFY_WEBHOOK_SECRET=
# Dominio myshopify de la tienda, ej. mitienda.myshopify.com
SHOPIFY_STORE_DOMAIN=
# Token Admin API de la app personalizada (shpat_...), para cancelar pedidos
# sin stock y sincronizar el tracking de vuelta a Shopify
SHOPIFY_ADMIN_TOKEN=
