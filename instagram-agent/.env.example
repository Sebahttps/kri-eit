# Copia esto a .env y rellena. NUNCA lo subas al repo.

# --- Meta / Instagram ---------------------------------------------------
# App Secret de tu app en developers.facebook.com (Configuración → Básica)
IG_APP_SECRET=
# Token que inventas tú y repites igual en el panel de webhooks de Meta
IG_VERIFY_TOKEN=
# Token de acceso de larga duración de la cuenta profesional (60 días, se renueva)
IG_ACCESS_TOKEN=
# Tu propio IGSID. OBLIGATORIO: el servicio no arranca sin esto.
# Es como el agente reconoce sus propios mensajes; sin el valor, un comentario
# tuyo en tu propia publicación entra como si fuera de otra persona y el agente
# puede terminar contestándose a sí mismo.
IG_IG_USER_ID=

# Con Instagram Login: https://graph.instagram.com
# Con Facebook Login (cuenta ligada a una página): https://graph.facebook.com
IG_GRAPH_BASE=https://graph.instagram.com
IG_GRAPH_VERSION=v23.0

# --- Modelo -------------------------------------------------------------
IG_ANTHROPIC_API_KEY=
IG_MODEL=claude-opus-5
IG_EFFORT=low

# --- Política de autonomía ---------------------------------------------
# Qué categorías responde solo. Quitar una la manda a borrador.
IG_AUTO_CATEGORIAS=reaccion_trivial,cumplido,saludo_conocido
IG_AUTO_CONFIANZA_MINIMA=0.80
IG_AUTO_MAX_POR_CONTACTO_DIA=3
IG_AUTO_MAX_CARACTERES=140
# true = no envía nada solo, todo pasa por el panel. Interruptor de pánico.
IG_MODO_SOLO_BORRADORES=false

# --- Panel --------------------------------------------------------------
# Contraseña larga y aleatoria: esta URL muestra tus DMs
IG_PANEL_TOKEN=
